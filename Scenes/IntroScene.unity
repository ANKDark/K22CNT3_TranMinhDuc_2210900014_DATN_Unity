--- !u!114 &1447813071
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1447813070}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e3b70d3d4ea46b47980e1307447e251, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryIntroController
  backgroundA: {fileID: 692750762}
  backgroundB: {fileID: 1867114239}
  storyText: {fileID: 370845813}
  textCanvasGroup: {fileID: 904038317}
  actionButton: {fileID: 774359632}
  voiceSource: {fileID: 0}
  stopVoiceOnSkip: 1
  waitVoiceToFinishIfDurationIsZero: 1
  typeSpeed: 0.035
  fadeDuration: 0.6
  textFadeDuration: 0.25
  overlapDelay: 0.08
  endSegmentFadeOutDelay: 0.05
  nextSceneName: Level1
  storyParts:
  - partName: "M\u1EDF \u0111\u1EA7u"
    segments:
    - content: "Th\u1EBF gi\u1EDBi \u0111\xE3 t\u1EEBng ch\xECm trong \xE1nh s\xE1ng."
      duration: 1
      specificBackground: {fileID: 0}
      voice: {fileID: 8300000, guid: 208d36434fd61d9429a4da98af805235, type: 3}
      voiceVolume: 1
    - content: "Trong th\u1EDDi \u0111\u1EA1i th\u1ECBnh v\u01B0\u1EE3ng, nh\xE2n
        lo\u1EA1i s\u1ED1ng d\u01B0\u1EDBi s\u1EF1 b\u1EA3o h\u1ED9 c\u1EE7a Th\u1EA7n
        \xC1nh S\xE1ng."
      duration: 2
      specificBackground: {fileID: 21300000, guid: 5e9e846f0f0246c4d9a199753a720a81, type: 3}
      voice: {fileID: 8300000, guid: e8ab1d12baf02944fb6c3dc3b1a21439, type: 3}
      voiceVolume: 1
    - content: "Nh\u1EEFng v\u01B0\u01A1ng qu\u1ED1c h\xF9ng m\u1EA1nh \u0111\u01B0\u1EE3c
        d\u1EF1ng l\xEAn, ma thu\u1EADt v\xE0 khoa h\u1ECDc c\xF9ng ph\xE1t tri\u1EC3n,
        v\xE0 l\xF2ng \u0111\u1EA5t \u0111\u01B0\u1EE3c khai ph\xE1 \u0111\u1EC3
        t\xECm ki\u1EBFm tri th\u1EE9c c\u1ED5 x\u01B0a."
      duration: 4
      specificBackground: {fileID: 0}
      voice: {fileID: 8300000, guid: 4d68fb56efe70404795dd97722f39b0b, type: 3}
      voiceVolume: 1
    - content: "Cho \u0111\u1EBFn ng\xE0y phong \u1EA5n b\u1ECB ph\xE1 v\u1EE1."
      duration: 2
      specificBackground: {fileID: 21300000, guid: 0e13c0bce0621a5439fdc2f64a69bb9d, type: 3}
      voice: {fileID: 8300000, guid: d9415fad71bcebf458bdf77dc0bcb05b, type: 3}
      voiceVolume: 1
    - content: "Kh\xF4ng ai bi\u1EBFt ch\xEDnh x\xE1c bi\u1EBFn c\u1ED1 b\u1EAFt
        \u0111\u1EA7u t\u1EEB \u0111\xE2u"
      duration: 1.7
      specificBackground: {fileID: 21300000, guid: 0e13c0bce0621a5439fdc2f64a69bb9d, type: 3}
      voice: {fileID: 8300000, guid: b1eb6cd88c427604a89d87e6eda95af4, type: 3}
      voiceVolume: 1
    - content: "Ch\u1EC9 bi\u1EBFt r\u1EB1ng t\u1EEB s\xE2u d\u01B0\u1EDBi l\xF2ng
        \u0111\u1EA5t, m\u1ED9t ngu\u1ED3n n\u0103ng l\u01B0\u1EE3ng h\u1EAFc \xE1m
        tr\xE0n l\xEAn, b\xF3p m\xE9o sinh linh v\xE0 l\xE0m s\u1EE5p \u0111\u1ED5
        c\xE1c th\xE0nh tr\xEC."
      duration: 9
      specificBackground: {fileID: 21300000, guid: 8b616a02583f69b42b2d1191083bfccc, type: 3}
      voice: {fileID: 8300000, guid: fe7b9ef728356cf468a9f0debba29eb5, type: 3}
      voiceVolume: 1
    - content: "Trong n\u1ED7 l\u1EF1c tuy\u1EC7t v\u1ECDng, c\xE1c \u0111\u1EA1i
        ph\xE1p s\u01B0 \u0111\xE3 th\u1EF1c hi\u1EC7n m\u1ED9t nghi th\u1EE9c c\u1EA5m
        k\u1EF5, d\u1ED3n to\xE0n b\u1ED9 h\u1EAFc kh\xED xu\u1ED1ng h\u1EC7 th\u1ED1ng
        h\u1EA7m ng\u1EE5c s\xE2u th\u1EB3m \u2013 Dark Dungeon."
      duration: 7
      specificBackground: {fileID: 21300000, guid: 34468c70c7f1b7a49a0112b9e4d3d3a5, type: 3}
      voice: {fileID: 8300000, guid: d5ac4cd83d166e843905eb04911a4dc1, type: 3}
      voiceVolume: 1
    - content: "Nhi\u1EC1u th\u1EBF k\u1EF7 sau"
      duration: 1
      specificBackground: {fileID: 21300000, guid: 0e13c0bce0621a5439fdc2f64a69bb9d, type: 3}
      voice: {fileID: 8300000, guid: d625303577168c3468b94ca79128e78d, type: 3}
      voiceVolume: 1
    - content: "M\u1ED9t l\u1EEF kh\xE1ch v\xF4 danh \u0111\u1EB7t ch\xE2n t\u1EDBi
        v\xF9ng t\xE0n t\xEDch b\u1ECB l\xE3ng qu\xEAn"
      duration: 2.5
      specificBackground: {fileID: 21300000, guid: 68e4e93e834827a478e4cb43f7b40828, type: 3}
      voice: {fileID: 8300000, guid: f8b729c037a81c54d8b650a65b2d34fe, type: 3}
      voiceVolume: 1
    - content: "T\u1EA1i \u0111\xE2y, anh ch\u1EA1m v\xE0o m\u1ED9t di v\u1EADt c\u1ED5
        \u0111\u1EA1i ph\xE1t ra \xE1nh s\xE1ng k\u1EF3 l\u1EA1. Khi di v\u1EADt
        c\u1ED9ng h\u01B0\u1EDFng, m\u1EB7t \u0111\u1EA5t rung chuy\u1EC3n, m\u1EDF
        ra l\u1ED1i xu\u1ED1ng Dark Dungeon."
      duration: 8
      specificBackground: {fileID: 0}
      voice: {fileID: 8300000, guid: 588949c155647e14cbe2976d37a9af50, type: 3}
      voiceVolume: 1
    - content: "Kh\xF4ng c\xF3 l\u1EDDi ti\xEAn tri."
      duration: 1.5
      specificBackground: {fileID: 21300000, guid: 0e13c0bce0621a5439fdc2f64a69bb9d, type: 3}
      voice: {fileID: 8300000, guid: 57f0feb2abc3d9b49b18a3c69ec998ff, type: 3}
      voiceVolume: 1
    - content: "Kh\xF4ng c\xF3 s\u1EE9 m\u1EC7nh \u0111\u01B0\u1EE3c ban ra."
      duration: 1.7
      specificBackground: {fileID: 21300000, guid: 0e13c0bce0621a5439fdc2f64a69bb9d, type: 3}
      voice: {fileID: 8300000, guid: 1960c8b9c027cd54b863eeac4cbc134b, type: 3}
      voiceVolume: 1
    - content: "Ch\u1EC9 c\xF3 m\u1ED9t con \u0111\u01B0\u1EDDng duy nh\u1EA5t m\u1EDF
        ra tr\u01B0\u1EDBc m\u1EAFt."
      duration: 2
      specificBackground: {fileID: 21300000, guid: ea87dcd00a4db67438a21611623ffa11, type: 3}
      voice: {fileID: 8300000, guid: 8276f30d587312d49acf0c1eef2da867, type: 3}
      voiceVolume: 1
